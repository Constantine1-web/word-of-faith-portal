datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleName {
  SUPER_ADMIN
  PRINCIPAL
  BURSAR
  ADMISSIONS
  TEACHER
  FORM_MASTER
  STUDENT
  PARENT
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum CardStatus {
  GENERATED
  ISSUED
  ACTIVE
  EXHAUSTED
}

enum PaymentChannel {
  PAYSTACK
  BANK_TELLER
  CASH_BURSARY
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  SUCCESSFUL
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  REPEATING
  WITHDRAWN
}

enum ParentRelationship {
  FATHER
  MOTHER
  GUARDIAN
}

model Role {
  RoleID      Int      @id @default(autoincrement())
  RoleName    String   @unique
  Permissions String   // JSON stringified
  Users       User[]
}

model User {
  UserID              Int       @id @default(autoincrement())
  Uuid                String?   @unique @default(uuid())
  Email               String    @unique
  PasswordHash        String
  RoleID              Int
  Role                Role      @relation(fields: [RoleID], references: [RoleID])
  IsActive            Boolean   @default(true)
  TokenVersion        Int       @default(1)
  MustChangePassword  Boolean   @default(false)
  FailedLoginAttempts Int       @default(0)
  LockedUntil         DateTime?
  TotpSecret          String?
  TotpEnabled         Boolean   @default(false)
  TotpBackupCodes     String?
  CreatedAt           DateTime  @default(now())
  UpdatedAt           DateTime  @default(now()) @updatedAt

  Student             Student?
  ParentProfile       Parent?
  RoleAssignments     UserRoleAssignment[]
  TeacherMaps         Teacher_Subject_Map[]
  FormMasterClasses   Class[]   @relation("ClassFormMaster")
  SentMessages        Message[] @relation("SentMessages")
  ReceivedMessages    Message[] @relation("ReceivedMessages")
  SubjectSubmissions  Subject_Submission[]
  AuditLogs           AuditLog[]
}

model UserRoleAssignment {
  id         String    @id @default(uuid())
  UserID     Int
  Role       RoleName
  AssignedAt DateTime  @default(now())
  AssignedBy String?

  User       User      @relation(fields: [UserID], references: [UserID], onDelete: Cascade)

  @@unique([UserID, Role])
}

model Class {
  ClassID            Int      @id @default(autoincrement())
  Uuid               String?  @unique @default(uuid())
  ClassName          String   @unique // e.g., "JSS 1 Gold", "Primary 4 Diamond"
  Level              String   // e.g., "Secondary", "Primary"
  Arm                String   @default("Gold")
  FormMasterID       Int?
  FormMaster         User?    @relation("ClassFormMaster", fields: [FormMasterID], references: [UserID])
  Students           Student[]
  Enrollments        Enrollment[]
  TeacherMaps        Teacher_Subject_Map[]
  SubjectSubmissions Subject_Submission[]
}

model Student {
  StudentID          Int       @id @default(autoincrement())
  Uuid               String?   @unique @default(uuid())
  UserID             Int?      @unique
  User               User?     @relation(fields: [UserID], references: [UserID])
  AdmissionNo        String    @unique
  ClaimCodeHash      String?
  ClaimCodeExpiresAt DateTime?
  FirstName          String?
  LastName           String?
  Gender             String?
  ClassID            Int
  Class              Class     @relation(fields: [ClassID], references: [ClassID])
  DateOfBirth        DateTime
  ParentContact      String    // Parent Phone number
  ParentEmail        String?   // Parent Email
  AvatarUrl          String?
  PreferredName      String?
  HasPaidFees        Boolean   @default(false)

  Results            Result[]
  ScratchCards       Scratch_Card[]
  PaymentRecords     Payment_Record[]
  Invoices           Invoice[]
  Enrollments        Enrollment[]
  ParentLinks        ParentStudentLink[]
  Attendances        Attendance[]
  FormMasterReports  Form_Master_Report[]
}

model Parent {
  id        String   @id @default(uuid())
  UserID    Int      @unique
  Phone     String   @unique
  AltPhone  String?
  Address   String?
  CreatedAt DateTime @default(now())

  User      User     @relation(fields: [UserID], references: [UserID], onDelete: Cascade)
  Children  ParentStudentLink[]
}

model ParentStudentLink {
  id                 String             @id @default(uuid())
  ParentID           String
  StudentID          Int
  Relationship       ParentRelationship @default(GUARDIAN)
  IsEmergencyContact Boolean            @default(true)

  Parent             Parent             @relation(fields: [ParentID], references: [id], onDelete: Cascade)
  Student            Student            @relation(fields: [StudentID], references: [StudentID], onDelete: Cascade)

  @@unique([ParentID, StudentID])
}

model Enrollment {
  id           String           @id @default(uuid())
  StudentID    Int
  ClassID      Int
  TermID       Int
  AcademicYear String           @default("2026/2027")
  Status       EnrollmentStatus @default(ACTIVE)

  Student      Student          @relation(fields: [StudentID], references: [StudentID], onDelete: Cascade)
  Class        Class            @relation(fields: [ClassID], references: [ClassID])
  Term         Academic_Term    @relation(fields: [TermID], references: [TermID])

  @@unique([StudentID, ClassID, TermID])
  @@index([ClassID, TermID])
}

model Subject {
  SubjectID          Int      @id @default(autoincrement())
  Uuid               String?  @unique @default(uuid())
  SubjectName        String   // e.g., "Mathematics", "English"
  SubjectCode        String?
  ClassLevel         String   // e.g., "Primary", "JSS", "SSS"
  TeacherMaps        Teacher_Subject_Map[]
  Results            Result[]
  SubjectSubmissions Subject_Submission[]
}

model Teacher_Subject_Map {
  id           Int            @id @default(autoincrement())
  Uuid         String?        @unique @default(uuid())
  TeacherID    Int
  Teacher      User           @relation(fields: [TeacherID], references: [UserID])
  SubjectID    Int
  Subject      Subject        @relation(fields: [SubjectID], references: [SubjectID])
  ClassID      Int
  Class        Class          @relation(fields: [ClassID], references: [ClassID])
  TermID       Int?
  Term         Academic_Term? @relation(fields: [TermID], references: [TermID])
  IsFormMaster Boolean        @default(false)
  AssignedAt   DateTime       @default(now())
  AssignedBy   String?

  @@unique([TeacherID, SubjectID, ClassID, TermID])
}

model Academic_Term {
  TermID             Int      @id @default(autoincrement())
  Uuid               String?  @unique @default(uuid())
  SessionName        String   // e.g., "2026/2027"
  TermName           String   // e.g., "First Term", "Second Term", "Third Term"
  IsActive           Boolean  @default(false)
  IsLocked           Boolean  @default(false) // Global freeze on scores across the school
  LockedAt           DateTime?
  LockedBy           String?
  Version            Int      @default(1)
  StartDate          DateTime?
  EndDate            DateTime?
  Results            Result[]
  PaymentRecords     Payment_Record[]
  Invoices           Invoice[]
  Enrollments        Enrollment[]
  Attendances        Attendance[]
  TeacherMaps        Teacher_Subject_Map[]
  ScratchCards       Scratch_Card[]
  SubjectSubmissions Subject_Submission[]
  FormMasterReports  Form_Master_Report[]
}

model Result {
  ResultID         Int           @id @default(autoincrement())
  Uuid             String?       @unique @default(uuid())
  StudentID        Int
  Student          Student       @relation(fields: [StudentID], references: [StudentID])
  SubjectID        Int
  Subject          Subject       @relation(fields: [SubjectID], references: [SubjectID])
  TermID           Int
  Term             Academic_Term @relation(fields: [TermID], references: [TermID])
  CAScore          Float         @default(0)
  ExamScore        Float         @default(0)
  TotalScore       Float         @default(0)
  CAScoreTenths    Int?          // v3 Integer tenths: 0 to 400 (0.0 to 40.0)
  ExamScoreTenths  Int?          // v3 Integer tenths: 0 to 600 (0.0 to 60.0)
  TotalScoreTenths Int?          // v3 Integer tenths: 0 to 1000 (0.0 to 100.0)
  Grade            String
  Remark           String?
  Version          Int           @default(1) // Optimistic concurrency
  UpdatedAt        DateTime      @default(now()) @updatedAt

  @@unique([StudentID, SubjectID, TermID])
}

model Subject_Submission {
  id             Int           @id @default(autoincrement())
  Uuid           String?       @unique @default(uuid())
  TeacherID      Int
  Teacher        User          @relation(fields: [TeacherID], references: [UserID])
  SubjectID      Int
  Subject        Subject       @relation(fields: [SubjectID], references: [SubjectID])
  ClassID        Int
  Class          Class         @relation(fields: [ClassID], references: [ClassID])
  TermID         Int
  Term           Academic_Term @relation(fields: [TermID], references: [TermID])
  Status         String        @default("Draft") // "Draft", "Submitted", "Approved"
  SubmittedAt    DateTime      @default(now())
  ApprovedBy     Int?
  ApprovedAt     DateTime?
  UnlockedBy     Int?
  UnlockedReason String?
  UnlockRequestedBy     Int?
  UnlockRequestedReason String?
  Version        Int           @default(1)

  @@unique([SubjectID, ClassID, TermID])
}

model Form_Master_Report {
  id                 Int           @id @default(autoincrement())
  StudentID          Int
  Student            Student       @relation(fields: [StudentID], references: [StudentID])
  TermID             Int
  Term               Academic_Term @relation(fields: [TermID], references: [TermID])
  FormMasterRemark   String?       // e.g. "An active, dedicated learner."
  PrincipalRemark    String?       // e.g. "Satisfactory performance."
  AffectiveTraits    String?       // JSON: { punctuality: 5, neatness: 4, ... }
  PsychomotorTraits  String?       // JSON: { handwriting: 4, sports: 5, ... }
  Status             String        @default("Draft") // "Draft", "SubmittedToAdmin", "Published"
  Version            Int           @default(1)
  UpdatedAt          DateTime      @updatedAt

  @@unique([StudentID, TermID])
}

model Scratch_Card {
  CardID              Int            @id @default(autoincrement())
  Uuid                String?        @unique @default(uuid())
  PIN_Hash            String         @unique // HMAC-SHA256 with server pepper
  SerialNumber        String         @unique
  KeyId               String         @default("v1")
  Status              String         @default("ISSUED") // GENERATED, ISSUED, ACTIVE, EXHAUSTED
  BatchId             String?
  UsageCount          Int            @default(0)
  MaxUsage            Int            @default(5)
  UsedBy              Int?     
  Student             Student?       @relation(fields: [UsedBy], references: [StudentID])
  TermID              Int?
  Term                Academic_Term? @relation(fields: [TermID], references: [TermID])
  ActiveWindowExpires DateTime?
  IssuedAt            DateTime?
  IssuedBy            Int?
  CreatedAt           DateTime       @default(now())
}

model Invoice {
  id           String           @id @default(uuid())
  StudentID    Int
  TermID       Int
  Title        String           // "2026/2027 First Term Tuition"
  AmountKobo   BigInt           // Integer kobo (e.g. ₦65,000 = 6500000)
  DueDate      DateTime
  IsWaived     Boolean          @default(false)
  WaivedBy     Int?
  WaivedReason String?
  CreatedAt    DateTime         @default(now())

  Student      Student          @relation(fields: [StudentID], references: [StudentID], onDelete: Cascade)
  Term         Academic_Term    @relation(fields: [TermID], references: [TermID])
  Payments     Payment_Record[]

  @@index([StudentID, TermID])
}

model Payment_Record {
  PaymentID       Int           @id @default(autoincrement())
  Uuid            String?       @unique @default(uuid())
  StudentID       Int
  Student         Student       @relation(fields: [StudentID], references: [StudentID])
  TermID          Int
  Term            Academic_Term @relation(fields: [TermID], references: [TermID])
  InvoiceID       String?
  Invoice         Invoice?      @relation(fields: [InvoiceID], references: [id])
  AmountPaid      Float         @default(0)
  AmountKobo      BigInt        @default(0) // v3 Integer kobo
  Channel         String        @default("BANK_TELLER") // PAYSTACK, BANK_TELLER, CASH_BURSARY
  ReceiptUrl      String?       // Private URL to uploaded receipt
  ReceiptHash     String?       // SHA-256 hash of receipt file to detect duplicates
  Reference       String?       @unique // Paystack transaction reference
  Status          String        @default("Pending") // "Pending", "Approved", "Rejected", "Successful"
  RejectionReason String?
  ReviewedBy      Int?
  ReviewedAt      DateTime?
  PaymentDate     DateTime      @default(now())
  Description     String        // e.g., "School Fees", "Uniforms"

  @@index([StudentID])
  @@index([TermID])
}

model AuditLog {
  id        String   @id @default(uuid())
  ActorID   Int?     // Nullable for unauthenticated attempts or webhooks
  Actor     User?    @relation(fields: [ActorID], references: [UserID])
  Action    String   // "SCORE_UPDATE", "TERM_FREEZE", "TELLER_APPROVAL", "UNLOCKED_SHEET"
  Entity    String   // "Result", "Subject_Submission", "Payment_Record"
  EntityID  String
  OldValue  Json?
  NewValue  Json?
  IpAddress String?
  UserAgent String?
  CreatedAt DateTime @default(now())

  @@index([Entity, EntityID])
  @@index([ActorID])
  @@index([CreatedAt])
}

model VerificationToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  type      String   // "EMAIL_VERIFICATION" or "PASSWORD_RESET" or "STAFF_INVITE"
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}

model Message {
  MessageID  Int      @id @default(autoincrement())
  SenderID   Int
  ReceiverID Int
  Content    String
  CreatedAt  DateTime @default(now())
  IsRead     Boolean  @default(false)

  Sender   User @relation("SentMessages", fields: [SenderID], references: [UserID])
  Receiver User @relation("ReceivedMessages", fields: [ReceiverID], references: [UserID])
}

model Attendance {
  AttendanceID Int      @id @default(autoincrement())
  StudentID    Int
  TermID       Int
  Date         DateTime
  Status       String   // "Present", "Absent", "Late"
  Notes        String?
  CreatedAt    DateTime @default(now())

  Student Student       @relation(fields: [StudentID], references: [StudentID])
  Term    Academic_Term @relation(fields: [TermID], references: [TermID])

  @@unique([StudentID, Date])
}

model Admission_Application {
  id                Int      @id @default(autoincrement())
  childFirstName    String
  childLastName     String
  dateOfBirth       DateTime
  gender            String
  parentName        String
  parentEmail       String
  parentPhone       String
  applyingClass     String
  previousSchool    String?
  status            String   @default("Pending") // "Pending", "Approved", "Rejected"
  createdAt         DateTime @default(now())
  enrolledStudentId Int?
}
