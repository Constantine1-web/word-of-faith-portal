datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleName {
  SUPER_ADMIN
  PRINCIPAL
  BURSAR
  ADMISSIONS
  TEACHER
  FORM_MASTER
  STUDENT
  PARENT
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum CardStatus {
  GENERATED
  ISSUED
  ACTIVE
  EXHAUSTED
}

enum PaymentChannel {
  PAYSTACK
  BANK_TELLER
  CASH_BURSARY
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  SUCCESSFUL
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  REPEATING
  WITHDRAWN
}

enum ParentRelationship {
  FATHER
  MOTHER
  GUARDIAN
}

enum AttemptMode {
  PRACTICE
  MOCK
  EXAM
}

enum CbtBankScope {
  OPEN_BANK
  EXAM_ONLY
}

enum CbtExamStatus {
  DRAFT
  SCHEDULED
  LIVE
  CLOSED
}

enum CbtSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED
}

enum AttemptStatus {
  ACTIVE
  SUBMITTED
  EXPIRED
  TERMINATED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum IntegrityEventType {
  TAB_HIDDEN
  WINDOW_BLUR
  FULLSCREEN_EXIT
  MULTI_SESSION
  HEARTBEAT_GAP
  DISCONNECT
  RESUME
  COPY_ATTEMPT
  PASTE_ATTEMPT
  CONTEXT_MENU
  PRINT_ATTEMPT
  DEVTOOLS_SUSPECT
  FAST_ANSWER
  LATE_ANSWER
}

enum Capability {
  MANAGE_USERS
  MANAGE_STRUCTURE
  MANAGE_STUDENTS
  CORRECT_SCORES
  APPROVE_RESULTS
  PUBLISH_RESULTS
  UNLOCK_SHEETS
  FREEZE_TERM
  MANAGE_FINANCE
  APPROVE_PAYMENTS
  MANAGE_CARDS
  MANAGE_CBT
  VIEW_AUDIT
  MANAGE_SYSTEM
}

enum ScoreStatus {
  PENDING
  ENTERED
  ABSENT
  EXEMPT
}

enum ScoreSource {
  GRID
  IMPORT
  ADMIN_CORRECTION
}

enum ExamMode {
  COMBINED
  HYBRID
}

enum ExamResultStatus {
  PENDING
  PARTIALLY_MARKED
  COMPLETED
  APPROVED
}

enum ImportStatus {
  UPLOADED
  VALIDATED
  COMMITTED
  REJECTED
  EXPIRED
}

enum UnlockStatus {
  REQUESTED
  APPROVED
  REJECTED
  USED
  EXPIRED
}

enum BroadsheetStatus {
  OPEN
  COMPUTED
  SIGNED_OFF
  PUBLISHED
}

enum LineItemBeneficiary {
  SCHOOL
  PROVIDER
  SHARED
  GATEWAY
}

enum LedgerEntryType {
  CREDIT
  REVERSAL
  ADJUSTMENT
}

enum LedgerSettlementStatus {
  PENDING_REMITTANCE
  AUTO_SPLIT
  REMITTED
  REVERSED
}

model Role {
  RoleID      Int    @id @default(autoincrement())
  RoleName    String @unique
  Permissions String // JSON stringified
  Users       User[]
}

model User {
  UserID              Int          @id @default(autoincrement())
  Uuid                String?      @unique @default(uuid())
  Email               String       @unique
  PasswordHash        String
  RoleID              Int
  Role                Role         @relation(fields: [RoleID], references: [RoleID])
  Capabilities        Capability[] @default([])
  IsActive            Boolean      @default(true)
  TokenVersion        Int          @default(1)
  MustChangePassword  Boolean      @default(false)
  FailedLoginAttempts Int          @default(0)
  LockedUntil         DateTime?
  TotpSecret          String?
  TotpEnabled         Boolean      @default(false)
  TotpBackupCodes     String?
  CreatedAt           DateTime     @default(now())
  UpdatedAt           DateTime     @default(now()) @updatedAt

  Student            Student?
  ParentProfile      Parent?
  RoleAssignments    UserRoleAssignment[]
  TeacherMaps        Teacher_Subject_Map[]
  FormMasterClasses  Class[]               @relation("ClassFormMaster")
  SentMessages       Message[]             @relation("SentMessages")
  ReceivedMessages   Message[]             @relation("ReceivedMessages")
  SubjectSubmissions          Subject_Submission[]
  AuditLogs                   AuditLog[]
  CbtQuestionSubmissions      CbtQuestionSubmission[] @relation("TeacherQuestionSubmissions")
  ReviewedQuestionSubmissions CbtQuestionSubmission[] @relation("ReviewerQuestionSubmissions")
}

model UserRoleAssignment {
  id         String   @id @default(uuid())
  UserID     Int
  Role       RoleName
  AssignedAt DateTime @default(now())
  AssignedBy String?

  User User @relation(fields: [UserID], references: [UserID], onDelete: Cascade)

  @@unique([UserID, Role])
}

model Class {
  ClassID            Int                   @id @default(autoincrement())
  Uuid               String?               @unique @default(uuid())
  ClassName          String                @unique // e.g., "JSS 1 Gold", "Primary 4 Diamond"
  Level              String // e.g., "Secondary", "Primary"
  Arm                String                @default("Gold")
  FormMasterID       Int?
  FormMaster         User?                 @relation("ClassFormMaster", fields: [FormMasterID], references: [UserID])
  Students           Student[]
  Enrollments        Enrollment[]
  TeacherMaps        Teacher_Subject_Map[]
  SubjectSubmissions Subject_Submission[]
  Broadsheets            ClassBroadsheet[]
  CbtScheduledExams      CbtScheduledExam[]
  CbtQuestionSubmissions CbtQuestionSubmission[]
  SubjectExamConfigs     SubjectExamConfig[]
}

model Student {
  StudentID          Int       @id @default(autoincrement())
  Uuid               String?   @unique @default(uuid())
  UserID             Int?      @unique
  User               User?     @relation(fields: [UserID], references: [UserID])
  AdmissionNo        String    @unique
  ClaimCodeHash      String?
  ClaimCodeExpiresAt DateTime?
  FirstName          String?
  LastName           String?
  Gender             String?
  ClassID            Int
  Class              Class     @relation(fields: [ClassID], references: [ClassID])
  DateOfBirth        DateTime?
  ParentContact      String // Parent Phone number
  ParentEmail        String? // Parent Email
  AvatarUrl          String?
  PreferredName      String?
  HasPaidFees        Boolean   @default(false)

  // ---- WOFS Student Identity (AdmissionNo holds the system-generated WOFS-STU-YYYY-NNNNNN ID) ----
  MiddleName           String?
  ParentName           String?
  GuardianVerified     Boolean   @default(false)
  // UNCLAIMED | INVITED | PENDING_OTP | PENDING_MANUAL_VERIFICATION | FLAGGED_DUPLICATE | CLAIMED | SUSPENDED
  RegistrationStatus   String    @default("UNCLAIMED")
  // ACTIVE | WITHDRAWN | GRADUATED | SUSPENDED (school enrolment status, independent of portal account)
  EnrolmentStatus      String    @default("ACTIVE")
  IdentityVerified     Boolean   @default(false)
  IdentityVerifiedAt   DateTime?
  IdentityVerifiedBy   Int?
  SiblingExceptionNote String?
  CreatedAt            DateTime  @default(now())
  UpdatedAt            DateTime  @default(now()) @updatedAt

  IdentityVerifications IdentityVerificationRecord[]
  VerificationRequests  StudentVerificationRequest[]

  Results           Result[]
  ScratchCards      Scratch_Card[]
  PaymentRecords    Payment_Record[]
  Invoices          Invoice[]
  LedgerEntries     AllocationLedger[]
  Enrollments       Enrollment[]
  ParentLinks       ParentStudentLink[]
  Attendances       Attendance[]
  FormMasterReports Form_Master_Report[]
  Claims            StudentClaim[]
  CbtAttempts       CbtAttempt[]
  CbtSubscriptions  CbtSubscription[]
  CbtDayLocks       CbtDayLock[]
  ReportCards       ReportCard[]
}

model Parent {
  id        String   @id @default(uuid())
  UserID    Int      @unique
  Phone     String   @unique
  AltPhone  String?
  Address   String?
  CreatedAt DateTime @default(now())

  User     User                @relation(fields: [UserID], references: [UserID], onDelete: Cascade)
  Children ParentStudentLink[]
}

model ParentStudentLink {
  id                 String             @id @default(uuid())
  ParentID           String
  StudentID          Int
  Relationship       ParentRelationship @default(GUARDIAN)
  IsEmergencyContact Boolean            @default(true)

  Parent  Parent  @relation(fields: [ParentID], references: [id], onDelete: Cascade)
  Student Student @relation(fields: [StudentID], references: [StudentID], onDelete: Cascade)

  @@unique([ParentID, StudentID])
}

model Enrollment {
  id           String           @id @default(uuid())
  StudentID    Int
  ClassID      Int
  TermID       Int
  AcademicYear String           @default("2026/2027")
  Status       EnrollmentStatus @default(ACTIVE)

  Student Student       @relation(fields: [StudentID], references: [StudentID], onDelete: Cascade)
  Class   Class         @relation(fields: [ClassID], references: [ClassID])
  Term    Academic_Term @relation(fields: [TermID], references: [TermID])

  @@unique([StudentID, ClassID, TermID])
  @@index([ClassID, TermID])
}

model Subject {
  SubjectID          Int                   @id @default(autoincrement())
  Uuid               String?               @unique @default(uuid())
  SubjectName        String // e.g., "Mathematics", "English"
  SubjectCode        String?
  ClassLevel         String // e.g., "Primary", "JSS", "SSS"
  TeacherMaps        Teacher_Subject_Map[]
  Results            Result[]
  SubjectSubmissions     Subject_Submission[]
  CbtScheduledExams      CbtScheduledExam[]
  CbtQuestionSubmissions CbtQuestionSubmission[]
  SubjectExamConfigs     SubjectExamConfig[]
}

model Teacher_Subject_Map {
  id           Int            @id @default(autoincrement())
  Uuid         String?        @unique @default(uuid())
  TeacherID    Int
  Teacher      User           @relation(fields: [TeacherID], references: [UserID])
  SubjectID    Int
  Subject      Subject        @relation(fields: [SubjectID], references: [SubjectID])
  ClassID      Int
  Class        Class          @relation(fields: [ClassID], references: [ClassID])
  TermID       Int?
  Term         Academic_Term? @relation(fields: [TermID], references: [TermID])
  IsFormMaster Boolean        @default(false)
  AssignedAt   DateTime       @default(now())
  AssignedBy   String?

  @@unique([TeacherID, SubjectID, ClassID, TermID])
}

model Academic_Term {
  TermID             Int                   @id @default(autoincrement())
  Uuid               String?               @unique @default(uuid())
  SessionName        String // e.g., "2026/2027"
  TermName           String // e.g., "First Term", "Second Term", "Third Term"
  IsActive           Boolean               @default(false)
  IsLocked           Boolean               @default(false) // Global freeze on scores across the school
  LockedAt           DateTime?
  LockedBy           String?
  Version            Int                   @default(1)
  StartDate          DateTime?
  EndDate            DateTime?
  Results            Result[]
  PaymentRecords     Payment_Record[]
  Invoices           Invoice[]
  LedgerEntries      AllocationLedger[]
  Enrollments        Enrollment[]
  Attendances        Attendance[]
  TeacherMaps        Teacher_Subject_Map[]
  ScratchCards       Scratch_Card[]
  SubjectSubmissions Subject_Submission[]
  FormMasterReports  Form_Master_Report[]
  Broadsheets            ClassBroadsheet[]
  ReportCards            ReportCard[]
  CbtScheduledExams      CbtScheduledExam[]
  CbtQuestionSubmissions CbtQuestionSubmission[]
  SubjectExamConfigs     SubjectExamConfig[]
}

model SubjectExamConfig {
  id                  String        @id @default(cuid())
  ClassID             Int
  Class               Class         @relation(fields: [ClassID], references: [ClassID], onDelete: Cascade)
  SubjectID           Int
  Subject             Subject       @relation(fields: [SubjectID], references: [SubjectID], onDelete: Cascade)
  TermID              Int
  Term                Academic_Term @relation(fields: [TermID], references: [TermID], onDelete: Cascade)
  ExamMode            ExamMode      @default(COMBINED)
  ExamCbtMaxTenths    Int           @default(400) // e.g. 400 = 40.0 marks
  ExamTheoryMaxTenths Int           @default(200) // e.g. 200 = 20.0 marks (must sum to 600 in HYBRID)
  ConfiguredById      Int?
  CreatedAt           DateTime      @default(now())
  UpdatedAt           DateTime      @default(now()) @updatedAt

  @@unique([ClassID, SubjectID, TermID])
  @@index([TermID, ExamMode])
}

model Result {
  ResultID         Int           @id @default(autoincrement())
  Uuid             String?       @unique @default(uuid())
  StudentID        Int
  Student          Student       @relation(fields: [StudentID], references: [StudentID])
  SubjectID        Int
  Subject          Subject       @relation(fields: [SubjectID], references: [SubjectID])
  TermID           Int
  Term             Academic_Term @relation(fields: [TermID], references: [TermID])
  CAScore          Float         @default(0)
  ExamScore        Float         @default(0)
  TotalScore       Float         @default(0)
  CAScoreTenths        Int? // v3 Integer tenths: 0 to 400 (0.0 to 40.0)
  ExamScoreTenths      Int? // v3 Integer tenths: 0 to 600 (0.0 to 60.0)
  TotalScoreTenths     Int? // v3 Integer tenths: 0 to 1000 (0.0 to 100.0)
  ExamCbtTenths        Int? // Hybrid Paper 1 CBT Objective in tenths
  ExamTheoryTenths     Int? // Hybrid Paper 2 Handwritten Theory in tenths
  ExamCbtMaxTenths     Int? // Snapshot of CBT max allocation in tenths
  ExamTheoryMaxTenths  Int? // Snapshot of Theory max allocation in tenths
  ExamResultStatus     ExamResultStatus @default(COMPLETED) // Legacy rows remain COMPLETED
  LastCbtSyncExamId    String? // Source CbtScheduledExam.id
  LastCbtSyncAttemptId String? // Source CbtAttempt.id
  LastCbtSyncAt        DateTime?
  Grade                String
  Remark           String?
  Status           ScoreStatus   @default(ENTERED)
  Source           ScoreSource   @default(GRID)
  ImportBatchID    String?
  UpdatedByID      Int?
  Version          Int           @default(1) // Optimistic concurrency
  UpdatedAt        DateTime      @default(now()) @updatedAt

  @@unique([StudentID, SubjectID, TermID])
}

model Subject_Submission {
  id                    Int             @id @default(autoincrement())
  Uuid                  String?         @unique @default(uuid())
  TeacherID             Int
  Teacher               User            @relation(fields: [TeacherID], references: [UserID])
  SubjectID             Int
  Subject               Subject         @relation(fields: [SubjectID], references: [SubjectID])
  ClassID               Int
  Class                 Class           @relation(fields: [ClassID], references: [ClassID])
  TermID                Int
  Term                  Academic_Term   @relation(fields: [TermID], references: [TermID])
  ScaleID               String?
  Scale                 GradeScale?     @relation(fields: [ScaleID], references: [id])
  Status                String          @default("Draft") // "Draft", "Submitted", "Approved"
  SubmittedAt           DateTime        @default(now())
  ApprovedBy            Int?
  ApprovedAt            DateTime?
  UnlockedBy            Int?
  UnlockedReason        String?
  UnlockRequestedBy     Int?
  UnlockRequestedReason String?
  WindowEndsAt          DateTime?
  Version               Int             @default(1)
  ImportBatches         ImportBatch[]
  UnlockRequests        UnlockRequest[]

  @@unique([SubjectID, ClassID, TermID])
}

model GradeScale {
  id         String               @id @default(cuid())
  name       String               @unique // "WAEC secondary", "Primary"
  levelGroup String // SECONDARY, PRIMARY, NURSERY
  bands      GradeBand[]
  sheets     Subject_Submission[]
}

model GradeBand {
  id        String     @id @default(cuid())
  scaleId   String
  scale     GradeScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  grade     String
  minTenths Int
  remark    String

  @@unique([scaleId, grade])
}

model ImportBatch {
  id                     String             @id @default(cuid())
  sheetId                Int
  sheet                  Subject_Submission @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  uploadedById           Int
  fileKey                String
  fileSha256             String
  sheetVersionAtDownload Int                @default(1)
  status                 ImportStatus       @default(UPLOADED)
  rowCount               Int                @default(0)
  errorCount             Int                @default(0)
  createdAt              DateTime           @default(now())
  committedAt            DateTime?
  expiresAt              DateTime
  rows                   ImportRow[]

  @@unique([sheetId, fileSha256])
}

model ImportRow {
  id          String       @id @default(cuid())
  batchId     String
  batch       ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber   Int
  admissionNo String
  caTenths    Int?
  examTenths  Int?
  status      ScoreStatus?
  error       String?
  changes     Boolean      @default(false)

  @@index([batchId])
}

model UnlockRequest {
  id            String             @id @default(cuid())
  sheetId       Int
  sheet         Subject_Submission @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  requestedById Int
  reason        String
  status        UnlockStatus       @default(REQUESTED)
  decidedById   Int?
  decidedAt     DateTime?
  decisionNote  String?
  windowEndsAt  DateTime?
  createdAt     DateTime           @default(now())

  @@index([sheetId, status])
}

model ClassBroadsheet {
  id             String           @id @default(cuid())
  classArmId     Int
  termId         Int
  classArm       Class            @relation(fields: [classArmId], references: [ClassID], onDelete: Cascade)
  term           Academic_Term    @relation(fields: [termId], references: [TermID], onDelete: Cascade)
  status         BroadsheetStatus @default(OPEN)
  computeVersion Int              @default(0)
  isStale        Boolean          @default(false)
  computedAt     DateTime?
  computedById   Int?
  signedOffAt    DateTime?
  signedOffById  Int?
  principalNote  String?
  publishedAt    DateTime?
  publishedById  Int?
  statsJson      Json?

  @@unique([classArmId, termId])
}

model ReportCard {
  id            String        @id @default(cuid())
  studentId     Int
  termId        Int
  student       Student       @relation(fields: [studentId], references: [StudentID], onDelete: Cascade)
  term          Academic_Term @relation(fields: [termId], references: [TermID], onDelete: Cascade)
  version       Int           @default(1)
  dataJson      Json
  dataSha256    String
  pdfKey        String?
  publishedAt   DateTime      @default(now())
  publishedById Int
  supersededAt  DateTime?
  changeReason  String?

  @@unique([studentId, termId, version])
  @@index([studentId, termId, supersededAt])
}

model Form_Master_Report {
  id                Int           @id @default(autoincrement())
  StudentID         Int
  Student           Student       @relation(fields: [StudentID], references: [StudentID])
  TermID            Int
  Term              Academic_Term @relation(fields: [TermID], references: [TermID])
  FormMasterRemark  String? // e.g. "An active, dedicated learner."
  PrincipalRemark   String? // e.g. "Satisfactory performance."
  AffectiveTraits   String? // JSON: { punctuality: 5, neatness: 4, ... }
  PsychomotorTraits String? // JSON: { handwriting: 4, sports: 5, ... }
  Status            String        @default("Draft") // "Draft", "SubmittedToAdmin", "Published"
  Version           Int           @default(1)
  UpdatedAt         DateTime      @updatedAt

  @@unique([StudentID, TermID])
}

model Scratch_Card {
  CardID              Int            @id @default(autoincrement())
  Uuid                String?        @unique @default(uuid())
  PIN_Hash            String         @unique // HMAC-SHA256(pepper[keyId], serial + ':' + pin)
  SerialNumber        String         @unique // Random base32 serial
  KeyId               String         @default("v1")
  Status              String         @default("ISSUED") // GENERATED, ISSUED, ACTIVE, EXHAUSTED, REVOKED
  BatchId             String?
  UsageCount          Int            @default(0)
  MaxUsage            Int            @default(5)
  FailedAttempts      Int            @default(0)
  LockedUntil         DateTime?
  UsedBy              Int?
  Student             Student?       @relation(fields: [UsedBy], references: [StudentID])
  TermID              Int?
  Term                Academic_Term? @relation(fields: [TermID], references: [TermID])
  ActiveWindowExpires DateTime?
  IssuedAt            DateTime?
  IssuedBy            Int?
  CreatedAt           DateTime       @default(now())
}

model ScratchCardBatch {
  id          String   @id @default(cuid())
  createdById Int
  size        Int
  pepperKeyId String   @default("v1")
  status      String   @default("ISSUED") // GENERATED, ISSUED
  createdAt   DateTime @default(now())
}

model StaffInvite {
  id          String    @id @default(cuid())
  email       String
  role        RoleName
  tokenHash   String    @unique
  invitedById Int
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

// Single-use registration invitation bound to exactly one Student record.
// Only SHA-256 hashes of the secret code/token are stored; the plaintext is shown once at issue time.
model StudentClaim {
  id           String    @id @default(cuid())
  studentId    Int
  student      Student   @relation(fields: [studentId], references: [StudentID], onDelete: Cascade)
  codeHash     String
  tokenHash    String?
  maskedCode   String?
  // ACTIVE | REDEEMED | REVOKED | EXPIRED
  status       String    @default("ACTIVE")
  channel      String?
  attempts     Int       @default(0)
  createdById  Int?
  revokedById  Int?
  revokedAt    DateTime?
  revokeReason String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?

  @@index([studentId, status])
  @@index([codeHash])
  @@index([tokenHash])
}

// Atomic per-year counter used to mint WOFS-STU-YYYY-NNNNNN identifiers.
model StudentSequence {
  year      Int      @id
  lastValue Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

// Manual registration pathway for students without reliable guardian contacts.
model StudentVerificationRequest {
  id                    String    @id @default(cuid())
  referenceCode         String    @unique
  studentId             Int?
  student               Student?  @relation(fields: [studentId], references: [StudentID], onDelete: SetNull)
  wofsStudentIdInput    String?
  firstName             String
  lastName              String
  middleName            String?
  dateOfBirth           DateTime
  gender                String?
  requestedClassId      Int?
  guardianName          String?
  guardianPhone         String?
  contactEmail          String
  contactPhone          String?
  passwordHash          String?
  verificationPhotoData String?
  reasonForManual       String
  // PENDING | IN_PERSON_REQUIRED | APPROVED | DECLINED
  status                String    @default("PENDING")
  reviewedById          Int?
  reviewedAt            DateTime?
  decisionReason        String?
  ipHash                String?
  createdAt             DateTime  @default(now())

  @@index([status, createdAt])
}

// Restricted identity-verification evidence. Deliberately separate from Student.AvatarUrl so that
// profile-picture changes can never alter verification state.
model IdentityVerificationRecord {
  id             String    @id @default(cuid())
  studentId      Int
  student        Student   @relation(fields: [studentId], references: [StudentID], onDelete: Cascade)
  // CLAIM_PHOTO | IN_PERSON | DOCUMENT
  method         String    @default("CLAIM_PHOTO")
  captureDataUrl String?
  perceptualHash String?
  // PENDING_REVIEW | VERIFIED | FLAGGED | EXCEPTION_APPROVED | REJECTED
  status         String    @default("VERIFIED")
  reviewedById   Int?
  reviewedAt     DateTime?
  notes          String?
  createdAt      DateTime  @default(now())

  @@index([studentId, status])
  @@index([perceptualHash])
}

// Investigation queue for possible duplicate identities (never auto-rejects).
model DuplicateReviewCase {
  id                    String    @id @default(cuid())
  primaryStudentId      Int?
  candidateStudentId    Int?
  verificationRequestId String?
  // NAME_DOB_MATCH | NAME_CLASS_MATCH | IMPORT_MATCH | BIOMETRIC_MATCH | CLAIM_CONFLICT
  matchType             String
  signalsJson           Json
  // OPEN | CLEARED_TWIN_SIBLING | CLEARED_DISTINCT | CONFIRMED_DUPLICATE
  status                String    @default("OPEN")
  resolutionNote        String?
  resolvedById          Int?
  resolvedAt            DateTime?
  createdAt             DateTime  @default(now())

  @@index([status, createdAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventKey    String    @unique
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

model Invoice {
  id                     String   @id @default(uuid())
  StudentID              Int
  TermID                 Int
  Title                  String // "2026/2027 First Term Fees & Portal/ICT Fee (₦1,000)"
  AmountKobo             BigInt // Integer kobo (School Tuition + Levies + Gross Portal/ICT Fee)
  Status                 String   @default("OPEN") // "OPEN", "PARTIAL", "PAID", "VOID"
  DueDate                DateTime
  IsWaived               Boolean  @default(false) // Waives School Tuition/Levies ONLY unless portalFeeExempt=true
  portalFeeExempt        Boolean  @default(false) // Board-approved hardship exemption for ₦1,000 Portal Fee
  portalFeeProrationPct  Int      @default(100)   // 100 = full ₦1,000; 50 = prorated ₦500 (if Board-approved)
  WaivedBy               Int?
  WaivedReason           String?
  CreatedAt              DateTime @default(now())
  UpdatedAt              DateTime @default(now()) @updatedAt

  Student       Student            @relation(fields: [StudentID], references: [StudentID], onDelete: Cascade)
  Term          Academic_Term      @relation(fields: [TermID], references: [TermID])
  Payments      Payment_Record[]
  LineItems     InvoiceLineItem[]
  LedgerEntries AllocationLedger[]

  @@index([StudentID, TermID])
}

model InvoiceLineItem {
  id          String              @id @default(cuid())
  invoiceId   String
  code        String // "TUITION" | "LEVIES" | "PORTAL_ICT_FEE" | "ADJUSTMENT"
  label       String
  beneficiary LineItemBeneficiary
  amountKobo  BigInt
  isWaivable  Boolean             @default(true)
  isWaived    Boolean             @default(false)
  createdAt   DateTime            @default(now())

  Invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, code])
  @@index([invoiceId, beneficiary])
}

model Payment_Record {
  PaymentID         Int           @id @default(autoincrement())
  Uuid              String?       @unique @default(uuid())
  StudentID         Int
  Student           Student       @relation(fields: [StudentID], references: [StudentID])
  TermID            Int
  Term              Academic_Term @relation(fields: [TermID], references: [TermID])
  InvoiceID         String?
  Invoice           Invoice?      @relation(fields: [InvoiceID], references: [id])
  AmountPaid        Float         @default(0)
  AmountKobo        BigInt        @default(0) // Net principal toward invoice (excludes gateway pass-through)
  gatewayFeeKobo    BigInt        @default(0) // Gateway convenience fee borne separately by payer
  Channel           String        @default("BANK_TELLER") // PAYSTACK, BANK_TELLER, CASH_BURSARY
  ReceiptUrl        String? // Protected download route or legacy key
  receiptStorageKey String? // Private non-public receipt storage key/payload ref
  ReceiptHash       String? // SHA-256 hash of receipt file to detect duplicates
  Reference         String?       @unique // Paystack transaction reference or Order Tracking ID
  Status            String        @default("Pending") // "Pending", "Approved", "Rejected", "Successful", "Refunded", "Disputed"
  RejectionReason   String?
  SubmittedBy       Int?
  ReviewedBy        Int?
  ReviewedAt        DateTime?
  PaymentDate       DateTime      @default(now())
  Description       String // e.g., "School Fees", "Uniforms"

  LedgerEntries AllocationLedger[]

  @@index([StudentID])
  @@index([TermID])
  @@index([InvoiceID])
}

model AllocationLedger {
  id                      String                 @id @default(uuid())
  paymentId               Int
  invoiceId               String?
  studentId               Int
  termId                  Int
  entryType               LedgerEntryType        @default(CREDIT)
  modelCode               String                 @default("PORTAL_FEE_1000_80_20")
  grossPaidKobo           BigInt // Signed kobo toward invoice principal (+credit, -reversal)
  grossPortalFeeKobo      BigInt                 @default(100000) // Gross Portal Fee term entitlement (₦1,000 = 100,000 kobo)
  gatewayFeeKobo          BigInt                 @default(0) // Separate gateway processing fee in kobo
  feeBearer               String                 @default("ACCOUNT") // ACCOUNT | SUBACCOUNT | PAYER_SURCHARGE
  schoolShareKobo         BigInt // Total School Share = schoolPortalShareKobo + schoolChargesShareKobo
  schoolPortalShareKobo   BigInt                 @default(0) // School 20% share of Portal Fee (max ₦200 = 20,000 kobo/term)
  schoolChargesShareKobo  BigInt                 @default(0) // 100% of School Tuition & non-Portal charges
  providerShareKobo       BigInt // Provider 80% share of Portal Fee (max ₦800 = 80,000 kobo/term)
  reversalOfLedgerEntryId String? // References original CREDIT row ID on REVERSAL rows
  reversalScope           String? // FULL | TUITION_ONLY | PORTAL_FEE_ONLY | CHARGEBACK
  settlementChannel       String                 @default("SCHOOL_COLLECTION") // PAYSTACK_SUBACCOUNT | SCHOOL_COLLECTION
  settlementStatus        LedgerSettlementStatus @default(PENDING_REMITTANCE)
  reference               String?
  notes                   String?
  createdById             Int?
  createdAt               DateTime               @default(now())

  Payment Payment_Record @relation(fields: [paymentId], references: [PaymentID])
  Invoice Invoice?       @relation(fields: [invoiceId], references: [id])
  Student Student        @relation(fields: [studentId], references: [StudentID])
  Term    Academic_Term  @relation(fields: [termId], references: [TermID])

  @@index([studentId, termId])
  @@index([paymentId])
  @@index([reversalOfLedgerEntryId])
  @@index([termId, settlementStatus])
}

model AuditLog {
  id           String   @id @default(uuid())
  ActorID      Int? // Nullable for unauthenticated attempts or webhooks
  Actor        User?    @relation(fields: [ActorID], references: [UserID])
  OnBehalfOfID Int? // Supervisory access logged under admin with teacher ID here
  Action       String // "SCORE_UPDATE", "TERM_FREEZE", "TELLER_APPROVAL", "UNLOCKED_SHEET"
  Entity       String // "Result", "Subject_Submission", "Payment_Record", "CbtAttempt"
  EntityID     String
  OldValue     Json?
  NewValue     Json?
  Reason       String?
  IpAddress    String?
  UserAgent    String?
  PrevHash     String?
  Hash         String? // SHA-256(prevHash + canonical row)
  CreatedAt    DateTime @default(now())

  @@index([Entity, EntityID])
  @@index([ActorID])
  @@index([CreatedAt])
}

// ---------- CBT & Integrity Subsystem (Nov 1 Blueprint Section 4 & 7) ----------

model CbtQuestion {
  id           String               @id @default(cuid())
  provider     String               @default("SDASH") // SDASH, ALOC, SCHOOL_INTERNAL
  externalId   String
  examBody     String // WAEC, NECO, JAMB
  subjectCode  String
  examYear     Int?
  topic        String?
  stem         String
  imageUrl     String?
  optionsJson  Json // [{key: "a", text: "..."}]
  contentHash        String
  licenseRef         String?
  bankScope          CbtBankScope               @default(OPEN_BANK)
  authoredById       Int?
  targetClassLevel   String?
  submissionId       String?
  submission         CbtQuestionSubmission?     @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  isEncrypted        Boolean                    @default(false)
  isActive           Boolean                    @default(true) // Kill switch if licence changes
  fetchedAt          DateTime                   @default(now())
  answerKey          CbtAnswerKey?
  attemptItems       CbtAttemptQuestion[]
  scheduledExamItems CbtScheduledExamQuestion[]

  @@unique([provider, externalId])
  @@index([subjectCode, examYear])
  @@index([provider, bankScope, subjectCode, isActive])
  @@index([submissionId])
}

model CbtAnswerKey {
  questionId  String      @id
  question    CbtQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  correctKey  String
  explanation String?
}

model CbtPlan {
  id           String            @id @default(cuid())
  name         String
  priceKobo    BigInt
  durationDays Int
  subjectCodes String[]
  isActive     Boolean           @default(true)
  subs         CbtSubscription[]
}

model CbtSubscription {
  id        String             @id @default(cuid())
  studentId Int
  planId    String
  paymentId Int?               @unique
  student   Student            @relation(fields: [studentId], references: [StudentID], onDelete: Cascade)
  plan      CbtPlan            @relation(fields: [planId], references: [id])
  startsAt  DateTime           @default(now())
  endsAt    DateTime
  status    SubscriptionStatus @default(ACTIVE)

  @@index([studentId, status])
}

model CbtAttempt {
  id                String               @id @default(cuid())
  studentId         Int
  student           Student              @relation(fields: [studentId], references: [StudentID], onDelete: Cascade)
  subjectCode       String
  examBody          String               @default("WASSCE")
  mode              AttemptMode          @default(PRACTICE)
  status            AttemptStatus        @default(ACTIVE)
  seed              String
  questionCount     Int
  durationSec       Int
  startedAt         DateTime             @default(now())
  expiresAt         DateTime // Server-authoritative timer
  submittedAt       DateTime?
  scoreTenths       Int?
  dayKey            String // YYYY-MM-DD in Africa/Lagos
  hardStrikes       Int                  @default(0)
  terminationReason String?
  sessionId         String?
  ipHash            String?
  uaHash            String?
  lastHeartbeatAt   DateTime?            @default(now())
  rulesAcceptedAt   DateTime?            @default(now())
  scheduledExamId   String?
  scheduledExam     CbtScheduledExam?    @relation(fields: [scheduledExamId], references: [id])
  isRetakeCleared   Boolean              @default(false)
  items             CbtAttemptQuestion[]
  events            CbtIntegrityEvent[]

  @@index([studentId, dayKey])
  @@index([scheduledExamId, studentId])
}

model CbtScheduledExam {
  id                     String                     @id @default(cuid())
  title                  String
  subjectCode            String
  subjectId              Int?
  subject                Subject?                   @relation(fields: [subjectId], references: [SubjectID])
  classId                Int
  classArm               Class                      @relation(fields: [classId], references: [ClassID])
  termId                 Int
  term                   Academic_Term              @relation(fields: [termId], references: [TermID])
  examType               String                     @default("TERMINAL_EXAM") // "CA_TEST" | "MIDTERM" | "TERMINAL_EXAM"
  status                 CbtExamStatus              @default(DRAFT)
  strictMode             Boolean                    @default(true)
  maxStrikes             Int                        @default(2)
  questionCount          Int                        @default(20)
  durationMinutes        Int                        @default(30)
  startsAt               DateTime?
  endsAt                 DateTime?
  accessCodeHash         String?
  requireAccessCode      Boolean                    @default(false)
  requireFeeClearance    Boolean                    @default(true)
  revealScoreAfterSubmit Boolean                    @default(false)
  answersReleased        Boolean                    @default(false)
  submissionId           String?
  submission             CbtQuestionSubmission?     @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  createdById            Int
  approvedById           Int?
  approvedAt             DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @default(now()) @updatedAt
  questions              CbtScheduledExamQuestion[]
  attempts               CbtAttempt[]
  roomCodes              CbtExamRoomCode[]

  @@index([classId, termId, status])
  @@index([subjectCode, status])
  @@index([submissionId])
}

model CbtQuestionSubmission {
  id                 String                  @id @default(cuid())
  teacherId          Int
  teacher            User                    @relation("TeacherQuestionSubmissions", fields: [teacherId], references: [UserID])
  classId            Int
  classArm           Class                   @relation(fields: [classId], references: [ClassID])
  subjectId          Int
  subject            Subject                 @relation(fields: [subjectId], references: [SubjectID])
  subjectCode        String
  termId             Int
  term               Academic_Term           @relation(fields: [termId], references: [TermID])
  examType           String                  @default("TERMINAL_EXAM") // "CA_TEST" | "MIDTERM" | "TERMINAL_EXAM"
  title              String
  status             CbtSubmissionStatus     @default(DRAFT)
  targetQuestionGoal Int                     @default(20)
  revisionNumber     Int                     @default(1)
  initialSubmittedAt DateTime?
  lastModifiedAt     DateTime                @default(now()) @updatedAt
  deadlineAt         DateTime?
  reviewerId         Int?
  reviewer           User?                   @relation("ReviewerQuestionSubmissions", fields: [reviewerId], references: [UserID])
  reviewedAt         DateTime?
  reviewerNotes      String?
  createdAt          DateTime                @default(now())
  questions          CbtQuestion[]
  revisions          CbtSubmissionRevision[]
  scheduledExams     CbtScheduledExam[]

  @@unique([teacherId, classId, subjectId, termId, examType])
  @@index([termId, status, initialSubmittedAt])
  @@index([classId, subjectId, termId])
}

model CbtSubmissionRevision {
  id            String                @id @default(cuid())
  submissionId  String
  submission    CbtQuestionSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  revisionNo    Int
  action        String // "SUBMITTED" | "RESUBMITTED" | "UNDER_REVIEW" | "APPROVED" | "REVISION_REQUESTED" | "REJECTED"
  actorId       Int
  actorEmail    String?
  notes         String?
  questionCount Int                   @default(0)
  snapshotJson  Json
  createdAt     DateTime              @default(now())

  @@index([submissionId, revisionNo])
}

model CbtExamRoomCode {
  id               String           @id @default(cuid())
  scheduledExamId  String
  scheduledExam    CbtScheduledExam @relation(fields: [scheduledExamId], references: [id], onDelete: Cascade)
  subjectCode      String
  codeHash         String
  codePreview      String // e.g., "MTH-****-WOF"
  isActive         Boolean          @default(true)
  activatesAt      DateTime         @default(now())
  expiresAt        DateTime
  generatedById    Int
  generatedByEmail String?
  revokedById      Int?
  revokedAt        DateTime?
  revokeReason     String?
  createdAt        DateTime         @default(now())

  @@index([scheduledExamId, isActive])
  @@index([codeHash])
}

model CbtScheduledExamQuestion {
  id              String           @id @default(cuid())
  scheduledExamId String
  scheduledExam   CbtScheduledExam @relation(fields: [scheduledExamId], references: [id], onDelete: Cascade)
  questionId      String
  question        CbtQuestion      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sortOrder       Int              @default(0)

  @@unique([scheduledExamId, questionId])
  @@index([scheduledExamId])
}

model CbtAttemptQuestion {
  id          String      @id @default(cuid())
  attemptId   String
  questionId  String
  attempt     CbtAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question    CbtQuestion @relation(fields: [questionId], references: [id])
  position    Int
  optionOrder Json // Shuffled option keys for this attempt e.g. ["c","a","d","b"]
  selectedKey String?
  answeredAt  DateTime?
  timeSpentMs Int?
  isCorrect   Boolean? // Set ONLY at submit transaction

  @@unique([attemptId, position])
}

model CbtIntegrityEvent {
  id        String             @id @default(cuid())
  attemptId String
  attempt   CbtAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type      IntegrityEventType
  isHard    Boolean            @default(false)
  clientAt  DateTime?
  serverAt  DateTime           @default(now())
  meta      Json?

  @@index([attemptId, serverAt])
}

model CbtDayLock {
  id         String    @id @default(cuid())
  studentId  Int
  student    Student   @relation(fields: [studentId], references: [StudentID], onDelete: Cascade)
  dayKey     String // YYYY-MM-DD in Africa/Lagos
  attemptId  String?
  reason     String
  liftedById Int?
  liftedAt   DateTime?
  liftReason String?
  createdAt  DateTime  @default(now())

  @@unique([studentId, dayKey])
}

model VerificationToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  type      String // "EMAIL_VERIFICATION" or "PASSWORD_RESET" or "STAFF_INVITE"
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}

model Message {
  MessageID  Int      @id @default(autoincrement())
  SenderID   Int
  ReceiverID Int
  Content    String
  CreatedAt  DateTime @default(now())
  IsRead     Boolean  @default(false)

  Sender   User @relation("SentMessages", fields: [SenderID], references: [UserID])
  Receiver User @relation("ReceivedMessages", fields: [ReceiverID], references: [UserID])
}

model Attendance {
  AttendanceID Int      @id @default(autoincrement())
  StudentID    Int
  TermID       Int
  Date         DateTime
  Status       String // "Present", "Absent", "Late"
  Notes        String?
  CreatedAt    DateTime @default(now())

  Student Student       @relation(fields: [StudentID], references: [StudentID])
  Term    Academic_Term @relation(fields: [TermID], references: [TermID])

  @@unique([StudentID, Date])
}

model Admission_Application {
  id                Int      @id @default(autoincrement())
  childFirstName    String
  childLastName     String
  dateOfBirth       DateTime
  gender            String
  parentName        String
  parentEmail       String
  parentPhone       String
  applyingClass     String
  previousSchool    String?
  status            String   @default("Pending") // "Pending", "Approved", "Rejected"
  createdAt         DateTime @default(now())
  enrolledStudentId Int?
}

// Per-level configurable school fee schedule + Portal/ICT Service Fee (stored in kobo)
model FeeSchedule {
  id                 String   @id @default(cuid())
  levelGroup         String   @unique // CRECHE_NURSERY | PRIMARY | JSS | SSS
  displayName        String
  tuitionKobo        BigInt
  leviesKobo         BigInt   @default(0)
  maintenanceFeeKobo BigInt   @default(100000) // Default ₦1,000 Gross Portal/ICT Fee (₦800 Provider / ₦200 School)
  isActive           Boolean  @default(true)
  updatedById        Int?
  updatedAt          DateTime @default(now()) @updatedAt
}

model PortalSetting {
  key         String   @id
  valueJson   Json
  updatedById Int?
  updatedAt   DateTime @default(now()) @updatedAt
}

model SchoolNotice {
  id             String    @id @default(uuid())
  type           String
  category       String
  title          String
  eventDate      String
  targetAudience String
  details        String
  color          String
  durationPreset String    @default("7d")
  durationLabel  String?
  expiresAt      DateTime?
  isDeleted      Boolean   @default(false)
  createdById    Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([isDeleted, expiresAt])
}

model ContactInquiry {
  id            String   @id @default(cuid())
  referenceCode String   @unique
  name          String
  email         String
  subject       String
  message       String
  ipAddress     String?
  status        String   @default("NEW")
  historyJson   Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
}
