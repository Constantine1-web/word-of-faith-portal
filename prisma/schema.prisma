datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  RoleID      Int      @id @default(autoincrement())
  RoleName    String   @unique
  Permissions String   // JSON stringified
  Users       User[]
}

model User {
  UserID       Int       @id @default(autoincrement())
  Email        String    @unique
  PasswordHash String
  RoleID       Int
  Role         Role      @relation(fields: [RoleID], references: [RoleID])
  IsActive     Boolean   @default(true)
  Student      Student?
  TeacherMaps  Teacher_Subject_Map[]
  SentMessages     Message[] @relation("SentMessages")
  ReceivedMessages Message[] @relation("ReceivedMessages")
}

model Class {
  ClassID     Int      @id @default(autoincrement())
  ClassName   String   @unique // e.g., "JSS 1A", "Primary 4"
  Level       String   // e.g., "Secondary", "Primary"
  Students    Student[]
  TeacherMaps Teacher_Subject_Map[]
}

model Student {
  StudentID     Int       @id @default(autoincrement())
  UserID        Int?      @unique
  User          User?     @relation(fields: [UserID], references: [UserID])
  AdmissionNo   String    @unique
  ClassID       Int
  Class         Class     @relation(fields: [ClassID], references: [ClassID])
  DateOfBirth   DateTime
  ParentContact String
  AvatarUrl     String?
  PreferredName String?
  Results       Result[]
  ScratchCards  Scratch_Card[]
  PaymentRecords Payment_Record[]
  Attendances   Attendance[]
}

model Subject {
  SubjectID   Int      @id @default(autoincrement())
  SubjectName String   // e.g., "Mathematics", "English"
  ClassLevel  String   // e.g., "Primary", "JSS", "SSS"
  TeacherMaps Teacher_Subject_Map[]
  Results     Result[]
}

model Teacher_Subject_Map {
  id        Int     @id @default(autoincrement())
  TeacherID Int
  Teacher   User    @relation(fields: [TeacherID], references: [UserID])
  SubjectID Int
  Subject   Subject @relation(fields: [SubjectID], references: [SubjectID])
  ClassID   Int
  Class     Class   @relation(fields: [ClassID], references: [ClassID])

  @@unique([TeacherID, SubjectID, ClassID])
}

model Academic_Term {
  TermID      Int      @id @default(autoincrement())
  SessionName String   // e.g., "2025/2026"
  TermName    String   // e.g., "First Term", "Second Term"
  IsActive    Boolean  @default(false)
  Results     Result[]
  PaymentRecords Payment_Record[]
  Attendances Attendance[]
}

model Result {
  ResultID    Int           @id @default(autoincrement())
  StudentID   Int
  Student     Student       @relation(fields: [StudentID], references: [StudentID])
  SubjectID   Int
  Subject     Subject       @relation(fields: [SubjectID], references: [SubjectID])
  TermID      Int
  Term        Academic_Term @relation(fields: [TermID], references: [TermID])
  CAScore     Float
  ExamScore   Float
  TotalScore  Float
  Grade       String

  @@unique([StudentID, SubjectID, TermID])
}

model Scratch_Card {
  CardID       Int      @id @default(autoincrement())
  PIN_Hash     String   @unique
  SerialNumber String   @unique
  UsageCount   Int      @default(0)
  MaxUsage     Int      @default(3)
  UsedBy       Int?     
  Student      Student? @relation(fields: [UsedBy], references: [StudentID])
}

model Payment_Record {
  PaymentID     Int           @id @default(autoincrement())
  StudentID     Int
  Student       Student       @relation(fields: [StudentID], references: [StudentID])
  TermID        Int
  Term          Academic_Term @relation(fields: [TermID], references: [TermID])
  AmountPaid    Float
  ReceiptUrl    String        // URL to uploaded receipt
  Status        String        @default("Pending") // "Pending", "Approved", "Rejected"
  PaymentDate   DateTime      @default(now())
  Description   String        // e.g., "School Fees", "Uniforms"

  @@index([StudentID])
  @@index([TermID])
}

model VerificationToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  type      String   // "EMAIL_VERIFICATION" or "PASSWORD_RESET"
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}

model Message {
  MessageID  Int      @id @default(autoincrement())
  SenderID   Int
  ReceiverID Int
  Content    String
  CreatedAt  DateTime @default(now())
  IsRead     Boolean  @default(false)

  Sender   User @relation("SentMessages", fields: [SenderID], references: [UserID])
  Receiver User @relation("ReceivedMessages", fields: [ReceiverID], references: [UserID])
}

model Attendance {
  AttendanceID Int      @id @default(autoincrement())
  StudentID    Int
  TermID       Int
  Date         DateTime
  Status       String   // "Present", "Absent", "Late"
  Notes        String?
  CreatedAt    DateTime @default(now())

  Student Student       @relation(fields: [StudentID], references: [StudentID])
  Term    Academic_Term @relation(fields: [TermID], references: [TermID])

  @@unique([StudentID, Date])
}

model Admission_Application {
  id              Int      @id @default(autoincrement())
  childFirstName  String
  childLastName   String
  dateOfBirth     DateTime
  gender          String
  parentName      String
  parentEmail     String
  parentPhone     String
  applyingClass   String
  previousSchool  String?
  status          String   @default("Pending") // "Pending", "Approved", "Rejected"
  createdAt       DateTime @default(now())
}
