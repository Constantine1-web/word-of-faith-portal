# ========================================================
# Word of Faith Schools - Environment Configuration Template
# Copy this file to .env and replace placeholders with real keys
# ========================================================

# Database (PostgreSQL via Neon / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/word_of_faith_portal"

# NextAuth.js
NEXTAUTH_SECRET="your_nextauth_32_character_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API (Faithbot Study Assistant & CBT AI Explanations)
GOOGLE_GENERATIVE_AI_API_KEY="your_google_gemini_api_key_here"

# SMTP Email Dispatch (OTP Verification & Portal Notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@wordoffaith.edu.ng"
SMTP_PASSWORD="your-smtp-app-password"
SMTP_FROM="noreply@wordoffaith.edu.ng"

# CBT Question Assessment Providers
# ALOC Station API v1 (https://aloc.com.ng)
# Authentication: X-API-Key header sent to https://dev.aloc.com.ng/api/v1/questions
ALOC_API_KEY="aloc_your_station_api_key_here"

# Secondary Backup Question Provider
SDASH_API_KEY="sdash_your_backup_api_key_here"
